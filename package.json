{
  "name": "one-meal-forward",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:python": "python3 -m ruff format scripts tests",
    "format:python:check": "python3 -m ruff format --check scripts tests",
    "lint": "eslint . --max-warnings 0",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:python": "node scripts/test-python.mjs",
    "test:browser": "playwright test",
    "dev": "node scripts/serve.mjs",
    "check": "npm run format:check && npm run format:python:check && npm run lint && npm test && npm run test:python && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}
